DirectoryIndex index.html
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Reindirizza solo le richieste browser ai vecchi URL, non i subrequest interni.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L,NE]

  RewriteCond %{THE_REQUEST} \s+/(?:studio|corsi|online|orari)\.html(?:[?\s]) [NC]
  RewriteRule ^(studio|corsi|online|orari)\.html$ /$1/ [R=301,L,NE]
</IfModule>
